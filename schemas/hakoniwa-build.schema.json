{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hakoniwalab.github.io/hakoniwa-envsim/schemas/hakoniwa-build.schema.json",
  "title": "Hakoniwa Envsim PLATEAU build manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "component", "pipeline", "source", "selection", "geometry", "mjcf", "glb", "city_world", "output"],
  "properties": {
    "version": {"const": 1},
    "component": {"const": "hakoniwa-envsim"},
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {"type": {"const": "plateau-citygml-to-assets"}}
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_base_url", "feature_type", "year"],
      "properties": {
        "api_base_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "cache_dir": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1}
          ]
        },
        "feature_type": {"const": "bldg"},
        "feature_types": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bldg", "tran", "dem", "frn"],
          "properties": {
            "bldg": {"const": true},
            "tran": {"type": "boolean"},
            "dem": {"type": "boolean"},
            "frn": {"type": "boolean"},
            "brid": {"type": "boolean"}
          }
        },
        "year": {"oneOf": [{"const": "latest"}, {"type": "integer", "minimum": 2000, "maximum": 9999}]}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["center", "half_extent_m"],
      "properties": {
        "center": {
          "type": "object", "additionalProperties": false,
          "required": ["latitude", "longitude"],
          "properties": {
            "latitude": {"type": "number", "minimum": -90, "maximum": 90},
            "longitude": {"type": "number", "minimum": -180, "maximum": 180}
          }
        },
        "half_extent_m": {
          "type": "object", "additionalProperties": false,
          "required": ["north_south", "east_west"],
          "properties": {
            "north_south": {"type": "number", "exclusiveMinimum": 0},
            "east_west": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      }
    },
    "geometry": {
      "type": "object", "additionalProperties": false,
      "required": ["base_epsilon_m", "waste_threshold", "wall_thickness_m", "roof_collision_thickness_m"],
      "properties": {
        "base_epsilon_m": {"type": "number", "exclusiveMinimum": 0},
        "waste_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "wall_thickness_m": {"type": "number", "exclusiveMinimum": 0},
        "roof_collision_thickness_m": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "mjcf": {
      "type": "object", "additionalProperties": false,
      "required": ["model_name", "collision", "floor"],
      "properties": {
        "model_name": {"type": "string", "minLength": 1},
        "collision": {"enum": ["all", "drone", "none"]},
        "floor": {"type": "boolean"},
        "building_physics_level": {"type": "integer", "minimum": 0, "maximum": 3, "default": 3}
      }
    },
    "glb": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "lod_policy", "texture_mode"],
      "properties": {
        "enabled": {"type": "boolean"},
        "lod_policy": {"const": "highest_available"},
        "texture_mode": {"enum": ["embedded-if-available", "flat"]}
      }
    },
    "city_world": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "terrain_spacing_m", "marking_vertical_offset_m"],
      "properties": {
        "enabled": {"type": "boolean"},
        "parallel_workers": {"type": "integer", "minimum": 1, "maximum": 16},
        "terrain_spacing_m": {"type": "number", "exclusiveMinimum": 0},
        "marking_vertical_offset_m": {"type": "number", "exclusiveMinimum": 0},
        "bridge_collision_thickness_m": {"type": "number", "exclusiveMinimum": 0},
        "bridge_max_surface_slope_deg": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 90}
      }
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["build_dir", "install_dir", "name"],
      "properties": {
        "build_dir": {"type": "string", "minLength": 1},
        "install_dir": {"type": "string", "minLength": 1},
        "name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"}
      }
    }
  }
}
